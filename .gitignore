# Ignore Python bytecode and cache
__pycache__/
*.pyc
*.pyo

# Ignore environment and dependency files
venv/
.env
*.log

# Ignore database (if using SQLite)
db.sqlite3

# Ignore Django secret key (optional, if in a file)
secrets.json

# Ignore service account credentials (IMPORTANT!)
google-credentials.json
*credentials*.json

# Images uploaded through the article editor live only where they were
# uploaded (production media), not in git.
newsletter_site/media/article_body_images/uploads/
